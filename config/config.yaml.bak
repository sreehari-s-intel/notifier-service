# ── Source mode ─────────────────────────────────────────────────────────────────
# mode: "elasticsearch" (direct ES queries) or "kibana_url" (fetch logs via HTTP URL)
source_mode: "kibana_url"

elasticsearch:
  host: "http://10.235.73.8:9200/"
  username: "paiv_admin"
  password: "password"
  index: "qpool-*"           # e.g. logs-*, filebeat-*
  poll_interval_seconds: 60       # how often to poll
  lookback_minutes: 2             # check last N minutes of data

# ── Kibana / Remote log URL source ─────────────────────────────────────────────
kibana_source:
  # url: "http://10.235.73.8:5601/api/console/proxy?path=qpool-*/_search&method=GET"
  url: "http://10.235.73.8:5601/app/discover#/?_a=(columns:!(log,kubernetes.host,kubernetes.container_image,kubernetes.labels.pipeline),filters:!(('$state':(store:appState),meta:(alias:!n,disabled:!f,index:efcfdf00-646b-11ee-bdf5-133d36d6568e,key:kubernetes.host,negate:!f,params:!(cs17ca101is0317,cs17ca101js0318),type:phrases),query:(bool:(minimum_should_match:1,should:!((match_phrase:(kubernetes.host:cs17ca101is0317)),(match_phrase:(kubernetes.host:cs17ca101js0318)))))),('$state':(store:appState),meta:(alias:!n,disabled:!t,index:efcfdf00-646b-11ee-bdf5-133d36d6568e,key:log,negate:!f,params:!(test-start-indicator,run-start-indicator,'TEST%20PASSED','TEST%20FAILED',Test,test-end-indicator,correctable),type:phrases),query:(bool:(minimum_should_match:1,should:!((match_phrase:(log:test-start-indicator)),(match_phrase:(log:run-start-indicator)),(match_phrase:(log:'TEST%20PASSED')),(match_phrase:(log:'TEST%20FAILED')),(match_phrase:(log:Test)),(match_phrase:(log:test-end-indicator)),(match_phrase:(log:correctable)))))),('$state':(store:appState),meta:(alias:!n,disabled:!f,index:efcfdf00-646b-11ee-bdf5-133d36d6568e,key:kubernetes.container_image,negate:!f,params:!('amr-registry-pre.caas.intel.com%2Fccx-registry%2Fccx-build%2Fmemory-ras-einj:latest','amr-registry-pre.caas.intel.com%2Fccx-registry%2Fxmlcli:v4.0'),type:phrases),query:(bool:(minimum_should_match:1,should:!((match_phrase:(kubernetes.container_image:'amr-registry-pre.caas.intel.com%2Fccx-registry%2Fccx-build%2Fmemory-ras-einj:latest')),(match_phrase:(kubernetes.container_image:'amr-registry-pre.caas.intel.com%2Fccx-registry%2Fxmlcli:v4.0')))))),('$state':(store:appState),meta:(alias:!n,disabled:!t,index:efcfdf00-646b-11ee-bdf5-133d36d6568e,key:kubernetes.container_image,negate:!t,params:(query:'amr-registry-pre.caas.intel.com%2Fccx-registry%2Fxmlcli:v4.0'),type:phrase),query:(match_phrase:(kubernetes.container_image:'amr-registry-pre.caas.intel.com%2Fccx-registry%2Fxmlcli:v4.0')))),index:efcfdf00-646b-11ee-bdf5-133d36d6568e,interval:auto,query:(language:kuery,query:''),sort:!(!('@timestamp',asc)))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'2026-07-22T13:47:55.628Z',to:'2026-07-22T13:50:09.061Z'))"
  username: "paiv_admin"
  password: "password"
  verify_ssl: false
  timeout_seconds: 30
  poll_interval_seconds: 60
  # Optional custom headers (e.g. kbn-xsrf for Kibana API)
  headers:
    kbn-xsrf: "true"

keywords:
  - "ERROR"
  - "CRITICAL"
  - "OutOfMemory"
  - "connection refused"
  # Add your keywords here

email:
  enabled: true
  smtp_host: "smtp.gmail.com"
  smtp_port: 587
  use_tls: true
  sender: ""
  password: ""
  recipients:
    - ""
    - ""

teams:
  enabled: true
  webhook_url: "https://outlook.office.com/webhook/YOUR_WEBHOOK_URL"

notification:
  # Avoid duplicate alerts for same hit within this window (seconds)
  dedup_window_seconds: 300

# ── Chat UI settings ──────────────────────────────────────────────────────────
chat:
  password: "changeme"            # Password for web UI access
  host: "0.0.0.0"
  port: 5001
  debug: false
  ollama_url: "http://localhost:11434"
  ollama_model: "llama3.2"        # Ollama model to use (must be pulled first)
